rules_version = '2';

// ====================================================================
// Book Platform v3 — Firestore Security Rules
// Paste in : Firebase Console → Build → Firestore Database → Rules
// Then press "Publish".
//
// What these rules guarantee :
//   1. Each user can read/write ONLY their own /users/{uid} document.
//   2. Favorites  : users/{uid}/favorites/{docId} — owner only.
//   3. Ratings    : books/{bookId}/ratings/{uid} — one doc per user per book.
//      - create/update ONLY by the owner (request.auth.uid == uid)
//      - the rating field "r" must be an INTEGER between 1 and 5
//      - nobody (not even the owner) can write aggregate statistics,
//        because aggregates simply do not exist in the database :
//        the site computes them from the real rating documents.
//   4. Anyone (guests too) may READ ratings, so the real average can be
//      displayed before logging in.
// ====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function validRating() {
      return request.resource.data.r is int
          && request.resource.data.r >= 1
          && request.resource.data.r <= 5;
    }

    // ---------- user profile + favorites ----------
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /favorites/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /ratings/{bookId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------- book ratings ----------
    match /books/{bookId} {
      allow read: if true;          // needed so guests see the average
      allow write: if false;        // no client ever writes the book doc

      match /ratings/{uid} {
        allow read: if true;        // stats are computed from real records
        allow create: if isOwner(uid) && validRating();
        allow update: if isOwner(uid) && validRating();
        allow delete: if isOwner(uid);
      }
    }

    // ---------- everything else is denied ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
